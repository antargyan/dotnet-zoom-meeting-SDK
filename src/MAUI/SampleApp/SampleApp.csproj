<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-android'">
      <MauiVersion>10.0.20</MauiVersion>
    </PropertyGroup>
    <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- mobilertc.aar is ~295 MB of Java; at a smaller heap d8/r8 thrashes for hours. -->
    <JavaMaximumHeapSize>6G</JavaMaximumHeapSize>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <!-- MUST stay true for the Zoom Meeting SDK. .NET Android 10 preloads every native library
         that JNI references at startup (dso_jni_preloads_idx in libxamarin-app.so), in alphabetical
         order. mobilertc.aar ships 84 native libs, four of which (libcmmlib, libzReflection,
         libzoombase_shared, libzUnifyWebViewApp) each export a preemptible global `g_javaVM` and set
         it from their own JNI_OnLoad via the GOT. Zoom's loader deliberately loads libzReflection
         FIRST so every reference binds to that copy; the alphabetical sweep loads libcmmlib (c)
         first instead, so libzVideoApp.so's g_javaVM binds to a copy nobody initialises. Joining a
         meeting then does GetEnv(g_javaVM=NULL, &env, JNI_VERSION_1_4) and SIGSEGVs at 0x0 inside
         Android_InitConfModule4SingleProcess. Disabling the preload lets Zoom's own Java loader
         control the order, which is what the working native sample does. -->
    <AndroidIgnoreAllJniPreload>true</AndroidIgnoreAllJniPreload>
    <!-- d8 lists every input jar on its command line; the aar expands to thousands, and at the
         default obj depth that exceeds Windows' 32 KB limit, surfacing as MSB6003 / Win32 206
         "filename or extension is too long" against java.exe. -->
    <ZoomAndroidObjRoot Condition="'$(ZoomAndroidObjRoot)' == ''">$(SystemDrive)\zsa\</ZoomAndroidObjRoot>
    <IntermediateOutputPath>$(ZoomAndroidObjRoot)$(Configuration)\</IntermediateOutputPath>
    	<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net7.0-tizen</TargetFrameworks> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>SampleApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>SampleApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.sampleapp</ApplicationId>
		<ApplicationIdGuid>5bdd51ef-135b-4666-95fc-47645857399d</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="..\Android\Lottie.Android\Lottie.Android.csproj" />
    <ProjectReference Include="..\Android\MobileRTC.Android\MobileRTC.Android.csproj" />
    <PackageReference Include="Xamarin.AndroidX.Security.SecurityCrypto" Version="1.1.0.2-alpha06" />
    <PackageReference Include="Xamarin.Google.Crypto.Tink.Android" Version="1.16.0.1" />
    <PackageReference Include="Xam.Plugins.Android.ExoPlayer.Core" Version="2.19.1" />
    <PackageReference Include="Xam.Plugins.Android.ExoPlayer.UI" Version="2.19.1" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.1.0.29" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.1" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.1.3" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.5" />
    <PackageReference Include="XAB.FlexboxLayout" Version="3.0.0.2" /> <!-- Check this one-->
    <PackageReference Include="Xamarin.AndroidX.MultiDex" Version="2.0.1.28" />
    <PackageReference Include="GoogleGson" Version="2.11.0.2" />
    <PackageReference Include="Xamarin.Android.Glide.Annotations" Version="4.16.0.14" />
    <PackageReference Include="Xamarin.Android.Glide" Version="4.16.0.14" />
    <!--<PackageReference Include="Naxam.EventBus.Droid" Version="3.0.0-pre1" />-->
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.3" />
    <!-- LOTTIE GOES HERE IN BUILD.GRADLE - WE RELY ON OUR CUSTOM PROJ-->
    <PackageReference Include="Xamarin.AndroidX.Window" Version="1.3.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Window.WindowJava" Version="1.3.0.2" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.20" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="2.2.20" />
    <!-- 1.10.2.1, not Zoom's declared 1.9.0: the AndroidX/Compose graph pulls
         KotlinX.Coroutines.Core.Jvm 1.10.2.1 (Compose.Runtime, Lifecycle, Activity, Core all require
         it), and the core classes come from that Jvm artifact. Leaving the android artifact at 1.9.0
         mixes versions and Zoom's init dies with
         "Module with the Main dispatcher is missing ... ensure it has the same version as
         kotlinx-coroutines-core". Zoom declares 1.9.0 as a minimum, so 1.10.2.1 satisfies it. -->
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.10.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.8.1" />
    <PackageReference Include="Karamunting.AndroidX.DaveMorrissey.SubsamplingScaleImageView" Version="3.10.0" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.11" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Ktx" Version="2.9.4" />
    <PackageReference Include="Xamarin.Android.ReactiveX.RxJava3.RxAndroid" Version="3.0.2.13" />
    <!-- material3-android at Zoom's OWN declared version (composeMaterial3Version in
         mobilertc/versions.gradle), not the 1.4.0.3 ceiling of the Xamarin NuGet binding. A working
         reference build of this exact SDK (7.1.6.41900) reports that anything older throws
         "NoSuchMethodError: shouldExecute(ZI)Z in androidx.compose.runtime.Composer" from Zoom's own
         compiled Compose screens - shouldExecute only exists from Compose runtime 1.8+.
         AndroidMavenLibrary, not a jar (contrast with Coil above): material3-android genuinely ships
         resources (175 res/values-*/values-*.xml entries for accessibility strings), so it goes
         through normal aapt2 processing and does not hit the coil-base .stamp/APT2144 defect.
         Bind="false": Zoom's Compose UI consumes this internally; no managed code here calls it. -->
    <AndroidMavenLibrary Include="androidx.compose.material3:material3-android" Version="1.5.0-alpha07" Repository="Google" Bind="false" />
    <!-- ================================================================================
         Dependencies Zoom's own code REFERENCES but our APK was missing entirely.
         Established by diffing the class sets of two APKs on the same device - Zoom's own
         Gradle-built sample (which reaches MEETING_STATUS_INMEETING) versus this app (which
         SIGSEGVs in libzVideoApp.so) - then counting, inside mobilertc.aar's 43,353 classes, how
         many reference each package our APK lacked:
             androidx/constraintlayout/compose   74 referencing classes   (0 present here)
             androidx/paging                     18
             androidx/credentials                16
             coil/compose                         6
         (androidx/compose/material scored 0 - those 951 classes in the working APK are the
         sample app's own UI, not an SDK requirement, so it is deliberately NOT added.)

         Zoom's SAMPLE build.gradle declares composeConstraintlayout / composePaging / coil /
         credentials / credentialsAuth. An earlier pass here removed credentials and paging on the
         grounds that mobilertc/build.gradle (the AAR module) does not declare them - that was the
         wrong file to check: the SDK still reaches for these classes at runtime, and a missing class
         behind Zoom's JNI/reflection boundary comes back null and gets dereferenced natively.
         ================================================================================ -->
    <AndroidMavenLibrary Include="androidx.constraintlayout:constraintlayout-compose-android" Version="1.1.1" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="androidx.paging:paging-compose-android" Version="3.3.5" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="androidx.paging:paging-runtime" Version="3.3.5" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil-compose" Version="2.3.0" Bind="false" />
    <AndroidMavenLibrary Include="io.coil-kt:coil-compose-base" Version="2.3.0" Bind="false" />
    <!-- coil-gif: Zoom's sample forces libraries.coilGif, and once the meeting UI actually starts
         (i.e. after the g_javaVM load-order fix below let the join succeed) ZmConfActivity builds its
         ImageLoader with a GifDecoder.Factory, giving
         ClassNotFoundException: coil.decode.GifDecoder$Factory. -->
    <AndroidMavenLibrary Include="io.coil-kt:coil-gif" Version="2.3.0" Bind="false" />
    <!-- credentials/credentialsAuth: declared by Zoom's sample, 16 referencing classes in the aar. -->
    <PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.2.2" />
    <!-- Real transitive dependencies of the packages added above (verifier-identified, all genuinely
         absent rather than naming mismatches). -->
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout.Core" Version="1.1.1.6" />
    <PackageReference Include="Xamarin.AndroidX.Paging.Common" Version="3.3.5.1" />
    <PackageReference Include="Xamarin.AndroidX.Paging.Common.Ktx" Version="3.3.5.1" />
    <!-- Required by coil-gif (XA4242); Zoom's sample forces libraries.vectordrawableAnimated too. -->
    <PackageReference Include="Xamarin.AndroidX.VectorDrawable.Animated" Version="1.1.0.26" />
    <!-- accompanist-drawablepainter pulled from Maven Central at coil-compose's exact required
         version (0.30.0) rather than via Xamarin.Google.Accompanist.DrawablePainter, whose only
         builds (0.37.3.x) depend on Compose UI 1.11.3.1 and would drag the whole Compose graph off
         Zoom's declared 1.9.4 line. -->
    <AndroidMavenLibrary Include="com.google.accompanist:accompanist-drawablepainter" Version="0.30.0" Bind="false" />
    <!-- ui-unit-android: satisfied in substance by Compose.UI 1.9.4 -> Compose.UI.Unit 1.9.4 (well
         above the 1.7.2 floor); the verifier cannot map the KMP-suffixed artifact id. -->
    <AndroidIgnoredJavaDependency Include="androidx.compose.ui:ui-unit-android:1.7.2" />
    <!-- Material3's own POM dependencies, satisfied explicitly (same reasoning as Coil's above). -->
    <PackageReference Include="Xamarin.AndroidX.Annotation.Experimental" Version="1.4.1.10" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.9.4" />
    <!-- Removing the old Material3 1.4.0 NuGet package (above) also removed the real, bound helper
         packages it used to pull in transitively - Compose.Material.Ripple and (indirectly)
         Graphics.Shapes were never replaced by anything once we switched to the raw AAR. Verified via
         nuspec inspection, not assumed: these two are genuinely ABSENT from the current graph, so
         they are added as real PackageReferences, not ignored. -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Material.Ripple" Version="1.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Graphics.Shapes" Version="1.0.1" />

    <!-- Everything below WAS verified present via nuspec inspection (not assumed): Material3
         1.5.0-alpha07's POM declares dependencies under the newer Kotlin-Multiplatform split artifact
         names, and androidx.annotation/collection's "-jvm" suffix, none of which the older-vintage
         Xamarin package tags advertise as matching. Each one traces to a real transitive package at
         >= the required floor:
           runtime-android          -> Compose.Runtime 1.9.4 -> Compose.Runtime.Android 1.9.4
           ui-android                -> Compose.UI 1.9.4 -> Compose.UI.Android 1.9.4
           ui-text-android           -> Compose.Foundation.Android 1.9.4 -> Compose.UI.Text.Android 1.9.4
           ui-util-android           -> Compose.Foundation.Android 1.9.4 -> Compose.UI.Util.Android 1.9.4
           foundation-android        -> Compose.Foundation 1.9.4 -> Compose.Foundation.Android 1.9.4
           foundation-layout-android -> Compose.Animation 1.9.4 -> Compose.Foundation.Layout 1.9.4
           animation-core-android    -> Compose.Foundation.Android 1.9.4 -> Compose.Animation.Android -> Compose.Animation.Core
           annotation-jvm            -> Compose.Foundation.Android 1.9.4 -> Annotation.Jvm 1.9.1.5
           collection-jvm            -> Compose.Foundation.Android 1.9.4 -> Collection.Jvm 1.5.0.3
         This is a naming/verification-mapping gap, not a missing runtime class. -->
    <AndroidIgnoredJavaDependency Include="androidx.compose.runtime:runtime-android:1.9.0-rc01" />
    <AndroidIgnoredJavaDependency Include="androidx.compose.ui:ui-android:1.8.2" />
    <!-- One entry per artifact id, not per version: AndroidIgnoredJavaDependency keys by
         groupId:artifactId internally, and a second entry for the same artifact at a different
         version throws XAJDV7004 ("item with the same key has already been added"), even though
         ui-text-android/ui-util-android are requested at two different floors (1.8.1 via
         foundation-android, 1.8.2 via material3-android's own direct deps). -->
    <AndroidIgnoredJavaDependency Include="androidx.compose.ui:ui-text-android:1.8.2" />
    <AndroidIgnoredJavaDependency Include="androidx.compose.ui:ui-util-android:1.8.2" />
    <!-- Material.Ripple and Graphics.Shapes ARE real, present PackageReferences (above) at versions
         >= these floors - the verifier still can't map them because they advertise the older
         non-KMP-suffixed artifact id, same class of gap as everything else here. -->
    <AndroidIgnoredJavaDependency Include="androidx.compose.material:material-ripple-android:1.8.1" />
    <AndroidIgnoredJavaDependency Include="androidx.graphics:graphics-shapes-android:1.0.1" />
    <AndroidIgnoredJavaDependency Include="androidx.compose.foundation:foundation-android:1.8.1" />
    <AndroidIgnoredJavaDependency Include="androidx.compose.foundation:foundation-layout-android:1.8.1" />
    <AndroidIgnoredJavaDependency Include="androidx.compose.animation:animation-core-android:1.8.1" />
    <AndroidIgnoredJavaDependency Include="androidx.annotation:annotation-jvm:1.9.1" />
    <AndroidIgnoredJavaDependency Include="androidx.collection:collection-jvm:1.5.0" />
    <!-- Compose.Runtime/UI/Foundation pinned explicitly as one matched set at 1.9.4 (Zoom's declared
         composeUIVersion/composeRuntimeVersion/composeFoundationVersion), rather than left to whatever
         a transitive resolution happens to pick. -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime" Version="1.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" Version="1.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation" Version="1.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling.Preview" Version="1.9.4" />
    <!-- MISSING  androidx.constraintlayout:constraintlayout-compose:1.0.1 -->
    <PackageReference Include="Xamarin.AndroidX.Activity.Compose" Version="1.11.0" />
    <!-- MISSING  androidx.lifecycle:lifecycle-runtime-compose:2.6.1 -->
    <PackageReference Include="Xamarin.AndroidX.Navigation.Compose" Version="2.9.2" />
    <!-- Coil, pulled straight from Maven at Zoom's declared version (coilVersion 2.3.0).
         Zoom 7.1.6 constructs a coil ImageLoader inside ZoomSDK.initialize, so without coil-base the
         SDK throws java.lang.ClassNotFoundException: coil.ImageLoader$Builder and init fails outright.
         Why not the NuGet bindings:
           - Binding.Io.CoilKt.CoilCompose 2.0.0 declares NO dependencies, so it never brings coil-base.
           - Io.CoilKt.Coil/CoilBase 2.0.0.3 resolve their Java deps through the Dependencies.Gradle
             package, which failed here with XACDJ7028 (kotlin-android-extensions-runtime jar missing
             from ~/.gradle/caches).
         Bind="false": these are only needed as Java classes at runtime; no managed API is generated. -->
    <!-- Coil 2.3.0 (Zoom's coilVersion). ZoomSDK.initialize constructs a coil ImageLoader, so
         without coil-base the SDK throws ClassNotFoundException: coil.ImageLoader$Builder.
         Kept in ..\CoilJars (outside every project folder) with Bind="false": a jar sitting inside a
         project directory is picked up by default @(AndroidLibrary) globbing and BOUND, and the
         generated managed Coil API does not compile (CS0535/CS0538/CS0426 on CrossfadeDrawable,
         IEventListener...). Only the Java classes are wanted here. -->
    <!-- JavaArtifact tells the dependency verifier these vendored jars ARE io.coil-kt:coil-base /
         io.coil-kt:coil 2.3.0, which coil-compose's POM requires (otherwise XA4241). -->
    <AndroidLibrary Include="..\CoilJars\coil-base-2.3.0.jar" Bind="false" JavaArtifact="io.coil-kt:coil-base:2.3.0" />
    <AndroidLibrary Include="..\CoilJars\coil-2.3.0.jar" Bind="false" JavaArtifact="io.coil-kt:coil:2.3.0" />
    <!-- coil-compose / coil-compose-base are deliberately NOT included: they require
         accompanist-drawablepainter, whose only current Xamarin binding (0.37.3.x) depends on
         Compose UI 1.11.3.1 and would drag the whole Compose graph off Zoom's 1.9.4 line - the exact
         version skew suspected of crashing Zoom's native conf module. coil.ImageLoader (what
         ZoomSDK.initialize needs) lives in coil-base. If a Zoom Compose screen turns out to need
         AsyncImage, pair coil-compose 2.3.0 with an accompanist build on Compose 1.9.x instead. -->
    <!-- Coil's POM dependencies, satisfied explicitly. AndroidMavenLibrary enforces these (XA4242)
         and that check is worth keeping: an unsatisfied Java dependency is precisely how the missing
         coil.ImageLoader slipped through before - it built fine and only failed at runtime. -->
    <PackageReference Include="Square.OkHttp3" Version="4.12.0.10" />
    <PackageReference Include="Square.OkIO" Version="3.9.1.4" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
    <!-- 1.7.1.1, matching AppCompat: 1.7.1.4 pulls Fragment 1.8.9.3 from the next generation and
         collides with the Lifecycle 2.9.x pins (NU1107). -->
    <PackageReference Include="Xamarin.AndroidX.AppCompat.AppCompatResources" Version="1.7.1.1" />
    <PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.4.2.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.ProfileInstaller.ProfileInstaller" Version="1.4.1.8" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.11.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.6.0" />
    <!-- Camera.Lifecycle pulls Tracing.Ktx 1.2.0.9 while everything else pulls Tracing 1.3.0.4.
         AndroidX merged tracing-ktx into tracing at 1.3, so both artifacts define
         androidx.tracing.TraceKt and R8 fails with "defined multiple times". The 1.3 main artifact
         has the classes, so drop the ktx one. -->
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="1.2.0.9" ExcludeAssets="all" />
    <!-- Xamarin Compose 1.9.4 ships androidx/compose/runtime/Immutable.class (and siblings) twice:
         Compose.Runtime -> Runtime.Annotation -> Annotation.Jvm (jar), and
         Compose.Runtime.Android -> Annotation.Android (aar). R8 then fails with
         "Type androidx.compose.runtime.Immutable is defined multiple times". Android needs the aar,
         so exclude the JVM variant. NOTE for consumers: this exclusion does not flow through the
         NuGet package - apps referencing zoommeetingsdk.dotnet.android need it too. -->
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.9.4" ExcludeAssets="all" />
    <!-- NOT declared by Zoom: androidx.credentials, credentials-play-services-auth,
         paging-compose and compose ui-viewbinding appear in mobilertc/versions.gradle but are never
         added to the aar's dependency configuration in build.gradle - they are unused entries in the
         version catalogue. Adding credentials-play-services-auth pulls a SECOND copy of the whole
         Play Services family (~1600 duplicate classes: gms.base, gms.common, gms.auth, gms.fido...)
         and R8 fails with "Type ... is defined multiple times". -->

  </ItemGroup>
  <!--
  Zoom's own R8/ProGuard keep rules, copied verbatim from proguard.cfg at the root of the
  Meeting SDK download.

  The aar ships NO proguard.txt, so R8 gets no keep rules from the library and a Release build
  shrinks Zoom's Java code. Zoom reaches much of it by reflection
  (ConfProcessMgrReflection::CreateConfProcess and friends), so the stripped classes come back null
  and the native side dereferences them: joining a meeting dies with
  SIGSEGV (fault addr 0x0) in libzVideoApp.so via Android_InitConfModule4SingleProcess.
  A native Android app applies this file through proguardFiles in build.gradle; the .NET equivalent
  is the ProguardConfiguration build action.

  CONSUMERS: apps using zoommeetingsdk.dotnet.android need this file too - keep rules do not flow
  through a NuGet package.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProguardConfiguration Include="zoom-proguard.cfg" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
	  <ProjectReference Include="..\iOS\MobileRTC.iOS\MobileRTC.iOS.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1605;NU1608</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
  The legacy manifest merger was previously forced here (via InitialTargets, because the
  Xamarin.AndroidX/Firebase buildTransitive targets assign AndroidManifestMerger unconditionally and
  import after the project body). It is NO LONGER USED, deliberately:

    * The two problems it worked around are both gone - the AMM0000 duplicate-namespace errors came
      from Xamarin.Google.MLKit.TextRecognition (since removed, see the note above), and the
      "minSdkVersion 23 cannot be smaller than 28" error is fixed by SupportedOSPlatformVersion=28.
    * It silently DROPS application-element attributes from library manifests. Verified by dumping
      the built APK's manifest: mobilertc.aar declares
      android:networkSecurityConfig="@xml/msdk_network_security_config" on its <application>, and
      that attribute was absent from the merged result. Components and meta-data still merged, so the
      loss is easy to miss.

  If AMM0000 duplicate-namespace errors ever return, fix the offending duplicate package properly
  rather than reinstating the legacy merger.
  -->
</Project>